# ==============================================================================
# VARIÁVEIS DE AMBIENTE — GESTÃO INTELIGENTE EMPRESARIAL
# ==============================================================================
# IMPORTANTE DE SEGURANÇA:
# - Nunca exponha segredos do servidor com o prefixo VITE_.
# - Nunca grave chaves privadas ou credenciais administrativas no navegador.
# ==============================================================================

# GEMINI_API_KEY: Chave da API Google Gemini (USO EXCLUSIVO NO BACKEND /server.ts).
# Configure no painel Settings > Secrets do AI Studio ou no ambiente do servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública onde a aplicação está hospedada (injetada em runtime).
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: URL base do backend Express (Cloud Run / servidor Node) quando o frontend
# estático estiver publicado no Firebase Hosting (ex.: https://erp-api-xxxx.a.run.app).
# Em desenvolvimento local ou quando frontend e backend rodam no mesmo domínio, deixe vazio.
VITE_API_BASE_URL=""

# FIREBASE_PROJECT_ID: ID do projeto Firebase para validação dos tokens JWT no servidor.
# Opcional quando o arquivo firebase-applet-config.json já estiver presente.
FIREBASE_PROJECT_ID=""

# VITE_FIREBASE_APPCHECK_SITE_KEY: Chave pública do site reCAPTCHA v3 / Enterprise
# para ativar o Firebase App Check no navegador (opcional, recomendada em produção).
# Obtenha em: Firebase Console > App Check > Apps > Registrar reCAPTCHA v3.
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN: Token de depuração para App Check em dev local.
# Deixe vazio em produção.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""
